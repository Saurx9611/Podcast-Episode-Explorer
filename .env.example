# ==========================================
# Podcast Explorer Backend Configuration
# ==========================================

# Application Settings
PROJECT_NAME="Podcast Explorer Backend"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api

# Database Settings (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=podcast_explorer

# Optional Direct Database URI (overrides individual postgres settings above)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/podcast_explorer

# CORS Configuration (JSON array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# File & Audio Storage
STORAGE_PATH=./audio_storage
MAX_UPLOAD_SIZE_MB=250

# Vector & AI Configuration
EMBEDDING_PROVIDER=fastembed # "fastembed", "mock", "openai"
EMBEDDING_DIMENSION=384
DEFAULT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Transcription Configuration
TRANSCRIPTION_PROVIDER=mock # "mock", "faster_whisper", "whisper"
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default

# Diarization Configuration
DIARIZATION_PROVIDER=mock # "mock", "pyannote", "acoustic"
HUGGINGFACE_AUTH_TOKEN=

# Insight Configuration
INSIGHT_PROVIDER=auto # "auto", "gemini", "openai", "mock"
DEFAULT_INSIGHT_MODEL=gemini-2.5-flash

# Optional External AI API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Frontend Configuration (for .env.local in Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
