# ==========================================
# Podcast Explorer — Git Ignore Configuration
# ==========================================

# ------------------------------------------
# Environment & Secrets
# ------------------------------------------
# Local environment configuration files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.local

# Explicitly keep the example environment template tracked
!.env.example

# Private keys, certificates, and credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
service-account*.json

# ------------------------------------------
# Next.js / Frontend
# ------------------------------------------
# Dependencies
node_modules/
/.pnp
.pnp.js

# Next.js build output & production artifacts
.next/
out/
build/
dist/
.open-next/

# TypeScript build info
tsconfig.tsbuildinfo

# ------------------------------------------
# Python / FastAPI
# ------------------------------------------
# Bytecode and compiled cache
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution & package metadata
*.egg-info/
*.egg
.eggs/
develop-eggs/
pip-wheel-metadata/

# ------------------------------------------
# Database
# ------------------------------------------
# Local development databases (SQLite / local instances)
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
podcast_explorer.db
postgres-data/
pgdata/

# NOTE: Database migrations in 'backend/alembic/versions/' and 'alembic.ini'
# MUST remain tracked by Git. Do NOT add rules ignoring them.

# ------------------------------------------
# Audio & Runtime Storage
# ------------------------------------------
# Local development audio uploads and runtime media storage
audio_storage/
/uploads/
/media/

# NOTE: 'backend/storage/' contains Python storage abstraction source code
# (base.py, local_storage.py) and MUST remain tracked.

# ------------------------------------------
# AI / ML Artifacts & Model Caches
# ------------------------------------------
# Model weights, checkpoint caches, and binary embeddings
.cache/huggingface/
.cache/torch/
checkpoints/
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# NOTE: 'backend/models/' contains SQLAlchemy ORM database entities
# (episode.py, speaker.py, transcript_segment.py, etc.) and MUST remain tracked.

# ------------------------------------------
# Logs
# ------------------------------------------
# Runtime log files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Cache
# ------------------------------------------
# Framework & linter cache
.cache/
.parcel-cache/
.turbo/
.eslintcache
.swc/

# ------------------------------------------
# Testing & Code Quality
# ------------------------------------------
# Test runners and coverage reports
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage/
.hypothesis/

# ------------------------------------------
# IDE & Editor
# ------------------------------------------
# Visual Studio Code (ignore user state, allow shared configuration)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains / PyCharm / WebStorm
.idea/

# Editors swap & backup files
*.swp
*.swo
*~
*.bak

# ------------------------------------------
# Operating System
# ------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini

# Linux
*~

# ------------------------------------------
# Temporary Files & Agent Artifacts
# ------------------------------------------
tmp/
temp/
*.tmp
*.temp
scratch/
.tempmediaStorage/
.system_generated/
